MODEM_HOST=192.168.123.1
MODEM_USER=admin
MODEM_PASSWORD=your_password_here
SCRAPE_INTERVAL=30
MODEM_TIMEOUT=10

# --- İsteğe bağlı: docker-compose.sre.yml (disk SMART + yedekleme izleme) ---
# Sadece "docker compose -f docker-compose.yml -f docker-compose.sre.yml up -d"
# ile bu ek servisleri çalıştırıyorsanız gereklidir. Bu makineye özeldir,
# kendi disk/dizin yollarınızla değiştirin.
SMARTCTL_DEVICE_1=/dev/sda
SMARTCTL_DEVICE_2=/dev/sdb
SMARTCTL_DEVICE_3=/dev/nvme0
SRE_METRICS_DIR=/home/ccakar/metrics
SRE_BACKUP_DISK_PATH=/mnt/IronWolf
