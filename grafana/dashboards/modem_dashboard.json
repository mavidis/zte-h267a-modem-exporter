      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "modem_wan_connected",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Kopuk", "color": "red" }, "1": { "text": "Bağlı", "color": "green" } } }
          ]
        }
      }
    },
    {
      "title": "Bağlı Cihaz Sayısı",
