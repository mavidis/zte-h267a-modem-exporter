      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "modem_scrape_success",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Başarısız", "color": "red" }, "1": { "text": "Sağlıklı", "color": "green" } } }
          ]
        }
      }
    },
    {
