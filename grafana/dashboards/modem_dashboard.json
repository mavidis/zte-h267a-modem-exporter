{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Exporter Sağlık Durumu (Scrape Success)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "modem_scrape_success",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Başarısız", "color": "red" }, "1": { "text": "Sağlıklı", "color": "green" } } }
          ]
        }
      }
    },
    {
      "title": "WAN Bağlantı Durumu",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "modem_wan_connected",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Kopuk", "color": "red" }, "1": { "text": "Bağlı", "color": "green" } } }
          ]
        }
      }
    },
    {
      "title": "Bağlı Cihaz Sayısı",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "modem_connected_devices_count",
          "refId": "A"
        }
      ]
    },
    {
      "title": "WAN Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "modem_wan_uptime_seconds",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations"
        }
      }
    },
    {
      "title": "Scrape Süresi",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 11,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "modem_scrape_duration_seconds",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        }
      }
    },
    {
      "title": "Scrape Hataları (Son 1s)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 12,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(increase(modem_scrape_errors_total[1h])) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "title": "WAN Ethernet Link Hızı (Mbps)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "modem_downstream_sync_speed_mbps",
          "legendFormat": "Downstream",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "modem_upstream_sync_speed_mbps",
          "legendFormat": "Upstream",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Mbit"
        }
      }
    },
    {
      "title": "WAN Trafiği (bps)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "rate(modem_wan_bytes_received_total[5m]) * 8",
          "legendFormat": "Download",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "rate(modem_wan_bytes_sent_total[5m]) * 8",
          "legendFormat": "Upload",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        }
      }
    },
    {
      "title": "WAN Fiziksel Link Durumu",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 12 },
      "id": 7,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "modem_wan_link_up",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Up", "color": "green" } } }
          ]
        }
      }
    },
    {
      "title": "Modem Bilgisi",
      "type": "table",
      "gridPos": { "h": 4, "w": 18, "x": 6, "y": 12 },
      "id": 8,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "modem_info",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true, "instance": true } } }
      ]
    },
    {
      "title": "WiFi Radyo Durumu",
      "type": "table",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 16 },
      "id": 9,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "modem_wifi_radio_enabled",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true }, "renameByName": { "Value": "Yayın Durumu" } } }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Kapalı", "color": "red" }, "1": { "text": "Açık", "color": "green" } } }
          ]
        }
      }
    },
    {
      "title": "Aktif Cihazlar",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 16 },
      "id": 10,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "modem_device_active == 1",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true, "instance": true } } }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 13,
      "title": "📊 Toplam WAN Kullanımı (Seçili Zaman Aralığı, Cihaz Ayrımı Yok)",
      "type": "row"
    },
    {
      "title": "İndirilen",
      "type": "stat",
      "description": "Modem cihaz bazlı trafik saymıyor (bkz. RUNBOOKS); bu, evin toplam WAN kullanımıdır. Sağ üstteki zaman aralığını değiştirerek (1s/24s/7g) o dönemin toplamını görebilirsiniz.",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 27 },
      "id": 14,
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "increase(modem_wan_bytes_received_total[$__range])", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "blue" }] } } }
    },
    {
      "title": "Yüklenen",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 27 },
      "id": 15,
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "increase(modem_wan_bytes_sent_total[$__range])", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "purple" }] } } }
    },
    {
      "title": "Toplam (İndirilen + Yüklenen)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 27 },
      "id": 16,
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "increase(modem_wan_bytes_received_total[$__range]) + increase(modem_wan_bytes_sent_total[$__range])", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "orange" }] } } }
    },
    {
      "title": "Günlük WAN Kullanımı (İndirilen/Yüklenen)",
      "type": "timeseries",
      "description": "Her nokta, o ana kadarki 1 günlük pencerede biriken toplam veriyi gösterir - günlük kullanım trendini karşılaştırmak için zaman aralığını 7g/30g yapın.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 31 },
      "id": 17,
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "increase(modem_wan_bytes_received_total[1d])", "legendFormat": "İndirilen (24s pencere)", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "increase(modem_wan_bytes_sent_total[1d])", "legendFormat": "Yüklenen (24s pencere)", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    }
  ],
  "refresh": "10s",
