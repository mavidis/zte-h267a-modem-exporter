    },
    {
      "title": "İstemci Sinyal / Bağlantı Bilgisi",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "id": 8,
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "unpoller_client_rssi_db", "format": "table", "instant": true, "refId": "A" }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "__name__": true, "job": true, "instance": true, "site_name": true, "source": true,
              "bssid": true, "gw_name": true, "identity": true, "network": true, "radio_desc": true, "radio_proto": true,
              "sw_name": true, "sw_port": true, "vlan": true, "mac": true
            },
            "renameByName": { "name": "Cihaz", "ip": "IP", "ap_name": "Bağlı AP", "essid": "WiFi Ağı", "channel": "Kanal", "radio": "Radyo", "radio_name": "Radyo Adı", "oui": "Üretici", "wired": "Kablolu", "Value": "RSSI (dB)" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 20, "color": "yellow" },
              { "value": 35, "color": "green" }
            ]
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "RSSI (dB)" }, "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-text" } }] }
        ]
      }
    },
    {
      "title": "İstemci Sinyal Gücü (RSSI, dB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "id": 9,
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "unpoller_client_rssi_db", "legendFormat": "{{name}} ({{essid}})", "refId": "A" }
      ]
    },
    {
      "title": "İstemci Veri Hızı (TX/RX)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "id": 10,
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "unpoller_client_transmit_rate_bytes", "legendFormat": "TX {{name}}", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "unpoller_client_receive_rate_bytes", "legendFormat": "RX {{name}}", "refId": "B" }
