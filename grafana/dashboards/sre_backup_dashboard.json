      "title": "Toplam Disk Kapasitesi",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 6 },
      "id": 7,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sre_backup_disk_total_bytes",
          "refId": "A"
