      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "count(count_over_time(unpoller_rogueap_signal[1h]))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "purple" }] } } }
