{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "İzlenen Disk Sayısı",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "smartctl_devices",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Sağlıksız Disk Sayısı",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "count(smartctl_device_smart_status == 0) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "title": "En Yüksek Disk Sıcaklığı",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "max(smartctl_device_temperature{temperature_type=\"current\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 45, "color": "yellow" },
              { "value": 55, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "title": "Toplam Reallocated Sector",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(smartctl_device_attribute{attribute_name=\"Reallocated_Sector_Ct\", attribute_value_type=\"raw\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "title": "Disk Sağlık Durumu",
      "type": "table",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 4 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "smartctl_device_smart_status",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true }, "renameByName": { "Value": "Durum", "device": "Disk" } } }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Arızalı", "color": "red" }, "1": { "text": "Sağlıklı", "color": "green" } } }
          ]
        }
      }
    },
    {
      "title": "Disk Bilgisi",
      "type": "table",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 4 },
      "id": 6,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "smartctl_device",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "Value": true, "__name__": true, "job": true, "instance": true,
              "ata_additional_product_id": true, "ata_version": true, "protocol": true,
              "sata_version": true, "scsi_product": true, "scsi_revision": true, "scsi_vendor": true, "scsi_version": true
            },
            "renameByName": { "device": "Disk", "model_name": "Model", "serial_number": "Seri No", "firmware_version": "Firmware", "form_factor": "Form Faktör", "interface": "Arayüz" }
          }
        }
      ]
    },
    {
      "title": "Disk Sıcaklıkları (°C)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "id": 7,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "smartctl_device_temperature{temperature_type=\"current\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        }
      }
    },
    {
      "title": "Reallocated / Pending Sector Sayıları",
      "type": "table",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 18 },
      "id": 8,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "smartctl_device_attribute{attribute_name=~\"Reallocated_Sector_Ct|Current_Pending_Sector|Offline_Uncorrectable|Reported_Uncorrect\", attribute_value_type=\"raw\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "attribute_id": true, "attribute_flags_long": true, "attribute_flags_short": true, "attribute_value_type": true },
            "renameByName": { "device": "Disk", "attribute_name": "Öznitelik", "Value": "Sayı" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          },
          "custom": { "cellOptions": { "type": "color-text" } }
        }
      }
    },
    {
      "title": "Disk Çalışma Süresi (Power-On)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 18 },
      "id": 9,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "smartctl_device_power_on_seconds",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations"
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["disk", "smart", "smartctl", "prometheus"],
  "time": { "from": "now-6h", "to": "now" },
  "title": "Disk Sağlığı (S.M.A.R.T.) İzleme Paneli",
  "uid": "disk-smart-health"
}
